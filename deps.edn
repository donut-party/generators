{:paths ["src" "resources"]
 :deps  {camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
         inflections/inflections             {:mvn/version "0.15.0"}
         party.donut/generate                {:mvn/version "1.0.77"}}

 :donut/lib {:name           party.donut/generators
             :description    "generators for Donut"
             :github         "donut-party/generators"
             :version-prefix "0.0"}

 :aliases
 {:dev
  {:extra-deps    {org.clojure/clojure {:mvn/version "1.12.4"}}
   :override-deps {party.donut/generate {:local/root "../generate"}}}

  :test
  {:extra-paths ["test" "dev-resources"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :exec-fn     cognitect.test-runner.api/test}
  
  :build
  {:deps       {io.github.donut-party/framework-build
                {:git/tag "v1" :git/sha "912e0b0"}}
   :ns-default donut.build}}}
